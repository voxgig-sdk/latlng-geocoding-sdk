# Entity: api

main: kit: entity: api: {

  alias: field: {}

  fields: {
    geometry: {
      h: "Geometry"
      n: "geometry"
      r: true
      t: "`$OBJECT`"
    }
    properties: {
      h: "Properties"
      n: "properties"
      r: true
      t: "`$OBJECT`"
    }
    type: {
      h: "Type"
      n: "type"
      r: true
      t: "`$STRING`"
    }
  }

  name: "api"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /api"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "api_key"
                or: "api_key"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "en"
                k: "query"
                n: "lang"
                or: "lang"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 52.52
                k: "query"
                n: "lat"
                or: "lat"
                r: false
                t: "`$NUMBER`"
              }
              {
                ex: 5
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 13.405
                k: "query"
                n: "lon"
                or: "lon"
                r: false
                t: "`$NUMBER`"
              }
              {
                ex: "Berlin"
                k: "query"
                n: "q"
                or: "q"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api"
          q: {
            exist: [
              "api_key"
              "lang"
              "lat"
              "limit"
              "lon"
              "q"
            ]
          }
          s: [
            {
              lit: "api"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.features`"
          }
        }
      ]
    }
  }



}
