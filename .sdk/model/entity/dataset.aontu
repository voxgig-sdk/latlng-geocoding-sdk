# Entity: dataset

main: kit: entity: dataset: {

  alias: field: {}

  fields: {
    features: {
      h: "Features"
      n: "features"
      r: true
      t: "`$ARRAY`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    type: {
      h: "Type"
      n: "type"
      r: true
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "dataset"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "features"
            "type"
          ]
          co: {
            id: "POST /v1/datasets"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/v1/datasets"
          rb: {
            alternatives: [
              {
                binary: true
                kind: "raw"
                media: "application/octet-stream"
              }
            ]
            kind: "json"
            media: "application/geo+json"
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "datasets"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v1/datasets/{datasetId}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "datasetId"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/datasets/{datasetId}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              datasetId: "id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "datasets"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "GET /v1/datasets"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/v1/datasets"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "datasets"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          co: {
            id: "DELETE /v1/datasets/{datasetId}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "datasetId"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "DELETE"
          o: "/v1/datasets/{datasetId}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              datasetId: "id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "datasets"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
