# Entity: map

main: kit: entity: map: {

  alias: field: {}

  fields: [
    {
      name: "features"
      req: true
      type: "`$ARRAY`"
    }
    {
      name: "type"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "map"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            query: [
              {
                example: "latlng_xxxxx"
                kind: "query"
                name: "key"
                orig: "key"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "POST /v1/static"
            json: "{\"operationId\":\"postStaticMap\",\"parameters\":[{\"example\":\"latlng_xxxxx\",\"in\":\"query\",\"name\":\"key\",\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/geo+json\":{\"schema\":{\"properties\":{\"features\":{\"items\":{\"properties\":{\"geometry\":{\"properties\":{\"coordinates\":{\"items\":{\"type\":\"number\"},\"type\":\"array\"},\"type\":{\"example\":\"Point\",\"type\":\"string\"}},\"required\":[\"type\",\"coordinates\"],\"type\":\"object\"},\"properties\":{\"additionalProperties\":true,\"type\":\"object\"},\"type\":{\"enum\":[\"Feature\"],\"type\":\"string\"}},\"required\":[\"type\",\"geometry\",\"properties\"],\"type\":\"object\"},\"type\":\"array\"},\"type\":{\"enum\":[\"FeatureCollection\"],\"type\":\"string\"}},\"required\":[\"type\",\"features\"],\"type\":\"object\"}},\"application/json\":{\"schema\":{\"properties\":{\"features\":{\"items\":{\"properties\":{\"geometry\":{\"properties\":{\"coordinates\":{\"items\":{\"type\":\"number\"},\"type\":\"array\"},\"type\":{\"example\":\"Point\",\"type\":\"string\"}},\"required\":[\"type\",\"coordinates\"],\"type\":\"object\"},\"properties\":{\"additionalProperties\":true,\"type\":\"object\"},\"type\":{\"enum\":[\"Feature\"],\"type\":\"string\"}},\"required\":[\"type\",\"geometry\",\"properties\"],\"type\":\"object\"},\"type\":\"array\"},\"type\":{\"enum\":[\"FeatureCollection\"],\"type\":\"string\"}},\"required\":[\"type\",\"features\"],\"type\":\"object\"}}},\"required\":false},\"responses\":{\"200\":{\"content\":{\"image/png\":{\"schema\":{\"format\":\"binary\",\"type\":\"string\"}}},\"description\":\"Static map image.\"},\"400\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Bad request or invalid parameters.\"},\"429\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Rate limit exceeded.\",\"headers\":{\"X-RateLimit-Limit\":{\"schema\":{\"type\":\"integer\"}},\"X-RateLimit-Remaining\":{\"schema\":{\"type\":\"integer\"}},\"X-Request-Id\":{\"schema\":{\"type\":\"string\"}}}}},\"security\":[{\"ApiKeyAuth\":[]},{\"ApiKeyQuery\":[]}],\"securitySchemes\":{\"ApiKeyAuth\":{\"in\":\"header\",\"name\":\"X-Api-Key\",\"type\":\"apiKey\"},\"ApiKeyQuery\":{\"in\":\"query\",\"name\":\"api_key\",\"type\":\"apiKey\"}},\"securitySource\":\"definition\"}"
            source: "openapi3"
            version: 1
          }
          method: "POST"
          orig: "/v1/static"
          segments: [
            {
              lit: "v1"
            }
            {
              lit: "static"
            }
          ]
          select: {
            exist: [
              "key"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                example: "40.748,-73.985"
                kind: "query"
                name: "center"
                orig: "center"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 600
                kind: "query"
                name: "height"
                orig: "height"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: "latlng_xxxxx"
                kind: "query"
                name: "key"
                orig: "key"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "40.748,-73.985"
                kind: "query"
                name: "marker"
                orig: "marker"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 800
                kind: "query"
                name: "width"
                orig: "width"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 12
                kind: "query"
                name: "zoom"
                orig: "zoom"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          contract: {
            id: "GET /v1/static"
            json: "{\"operationId\":\"getStaticMap\",\"parameters\":[{\"example\":\"latlng_xxxxx\",\"in\":\"query\",\"name\":\"key\",\"schema\":{\"type\":\"string\"}},{\"description\":\"Map center as latitude,longitude.\",\"example\":\"40.748,-73.985\",\"in\":\"query\",\"name\":\"center\",\"schema\":{\"type\":\"string\"}},{\"example\":12,\"in\":\"query\",\"name\":\"zoom\",\"schema\":{\"maximum\":22,\"minimum\":0,\"type\":\"integer\"}},{\"example\":800,\"in\":\"query\",\"name\":\"width\",\"schema\":{\"maximum\":2048,\"minimum\":1,\"type\":\"integer\"}},{\"example\":600,\"in\":\"query\",\"name\":\"height\",\"schema\":{\"maximum\":2048,\"minimum\":1,\"type\":\"integer\"}},{\"description\":\"Optional marker coordinates.\",\"example\":\"40.748,-73.985\",\"in\":\"query\",\"name\":\"markers\",\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"image/png\":{\"schema\":{\"format\":\"binary\",\"type\":\"string\"}}},\"description\":\"Static map image.\"},\"400\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Bad request or invalid parameters.\"},\"429\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Rate limit exceeded.\",\"headers\":{\"X-RateLimit-Limit\":{\"schema\":{\"type\":\"integer\"}},\"X-RateLimit-Remaining\":{\"schema\":{\"type\":\"integer\"}},\"X-Request-Id\":{\"schema\":{\"type\":\"string\"}}}}},\"security\":[{\"ApiKeyAuth\":[]},{\"ApiKeyQuery\":[]}],\"securitySchemes\":{\"ApiKeyAuth\":{\"in\":\"header\",\"name\":\"X-Api-Key\",\"type\":\"apiKey\"},\"ApiKeyQuery\":{\"in\":\"query\",\"name\":\"api_key\",\"type\":\"apiKey\"}},\"securitySource\":\"definition\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/v1/static"
          segments: [
            {
              lit: "v1"
            }
            {
              lit: "static"
            }
          ]
          select: {
