                kind: "query"
                name: "type"
                orig: "type"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/v1/places/search"
          parts: [
            "v1"
            "places"
            "search"
          ]
          select: {
            "$action": "search"
            exist: [
              "api_key"
              "category"
              "country"
              "lat"
              "limit"
              "lon"
              "q"
              "type"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            query: [
              {
                kind: "query"
                name: "api_key"
                orig: "api_key"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "cafe"
