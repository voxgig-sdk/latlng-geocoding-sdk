# Entity: utility

main: kit: entity: utility: {

  alias: field: {}

  fields: [
    {
      name: "status"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "utility"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/health"
          segments: [
            {
              lit: "health"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
