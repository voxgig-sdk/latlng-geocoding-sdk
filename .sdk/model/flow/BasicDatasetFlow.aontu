# BasicDatasetFlow

main: kit: flow: BasicDatasetFlow:
{
  entity: "dataset",
  kind: "basic",
  name: "BasicDatasetFlow",
  step: [
    {
      i: {
        ref: "dataset_ref01"
      }

      o: "create"
    }

    {
      i: {
        ref: "dataset_ref01",
        srcdatavar: "dataset_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-dataset_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "dataset_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "dataset01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicDatasetFlow"
}